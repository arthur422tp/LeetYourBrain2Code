{
  "manifest_version": 3,
  "name": "LeetCode Python Execution Visualizer",
  "version": "0.1.0",
  "permissions": [
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
